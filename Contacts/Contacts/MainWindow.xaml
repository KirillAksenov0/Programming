<Window x:Class="Contacts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Contacts"
        mc:Ignorable="d"
        Title="Contacts" Height="550" Width="665">
    <Window.Resources>
        
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="130"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <GroupBox Grid.Row="0" Grid.Column="0" Header="Edit Contact"
         Width="300" Height="350" Margin="15 15 0 0">

            <StackPanel>
                <Label x:Name="NameLabelInEditContact" Content="Name:" 
                  Height="25" HorizontalAlignment="Left" Margin="3 3 3 3">
                </Label>
                
                <TextBox x:Name="NameTextBox" Text="{Binding Path=Name}" Width="275"
                  HorizontalAlignment="Left" Margin="3 3 3 3" Height="20">
                </TextBox>
                
                <Label x:Name="PhonNumberLabelInEditContact" Content="Phone Number:" 
                  Height="25" HorizontalAlignment="Left" Margin="3 3 3 3">
                </Label>
                
                <TextBox x:Name="PhoneNumberTextBox" Text="{Binding Path=PhoneNumber}" Width="275"
                 Height="20" HorizontalAlignment="Left" Margin="3 3 3 3">
                </TextBox>

                <Label x:Name="EmailLabelInEditContact" Content="Email:" 
                 Height="25" HorizontalAlignment="Left" Margin="3 3 3 3">
                </Label>
                
                <TextBox x:Name="EmailTextBox" Text="{Binding Path=Email}" Width="275"
                 Height="20" HorizontalAlignment="Left" Margin="3 3 3 3">
                </TextBox>
            </StackPanel>
        </GroupBox>
        <GroupBox Grid.Row="0" Grid.Column="1" Header="Read Contact"
          Width="300" Height="350" Margin="0 15 15 0">

            <StackPanel>
                <Label x:Name="NameLabelInReadContact" Content="Name:" 
                  Height="25" HorizontalAlignment="Left" Margin="3 3 3 3">
                </Label>

                <TextBox Text="{Binding ElementName=NameTextBox, Path=Text}" x:Name="NameTextBoxInRaedContact"
                  HorizontalAlignment="Left" Margin="3 3 3 3" Width="275" Height="20"
                  BorderThickness="0" FontWeight="Bold">
                </TextBox>

                <Label x:Name="PhonNumberLabelInReadContact" Content="Phone Number:"
                   Height="25" HorizontalAlignment="Left" Margin="3 3 3 3"> 
                </Label>

                <TextBox x:Name="FullPhoneNumberLabelInReadContact" Text="{Binding ElementName=PhoneNumberTextBox, Path=Text}"
                  Height="20" Width="275" HorizontalAlignment="Left" Margin="3 3 3 3" FontWeight="Bold"
                         BorderThickness="0">
                </TextBox>

                <Label x:Name="EmailLabelInReadContact" Height="25"
                    Content="Email:" HorizontalAlignment="Left"
                    Margin="3 3 3 3">
                </Label>

                <TextBox x:Name="FullEmailLabelInReadContact" Text="{Binding ElementName=EmailTextBox, Path=Text}"
                     Height="20" Width="275" HorizontalAlignment="Left" Margin="3 3 3 3" FontWeight="Bold"
                     BorderThickness="0">
                </TextBox>
            </StackPanel>

        </GroupBox>

        <Button Grid.Row="1" Grid.Column="1" Width="75" Height="25"
         Content="Load" HorizontalAlignment="Right"
         VerticalAlignment="Top"
         Margin="0 15 20 0">
        </Button>
        <Button Grid.Row="1" Grid.Column="1" Width="75" Height="25"
         Content="Save" HorizontalAlignment="Right"
         VerticalAlignment="Top"
         Margin="0 15 100 0">
        </Button>

    </Grid>
</Window>
