<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        xmlns:Converters="clr-namespace:View.Converters"
        mc:Ignorable="d"
        Title="Contacts" 
        Height="500" 
        MinHeight="500" 
        Width="720"
        MinWidth="720"
        Icon="/books16.ico">
    <Window.Resources>
        <Converters:BoolToVisibilityConverter 
            x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <Canvas Grid.Row="0" Grid.Column="0" Background="#f8f8f8"/>

        <Canvas Grid.Row="1" Grid.Column="0" Background="#f8f8f8"/>

        <Canvas Grid.Row="2" Grid.Column="0" Background="#f8f8f8"/>

        <GridSplitter Grid.Column="1" 
             ShowsPreview="False"
             Width="3"
             HorizontalAlignment="Center"
             VerticalAlignment="Stretch"
             Grid.RowSpan="3"/>

        <Grid Grid.Column="0"
              Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <DockPanel LastChildFill="True"
                   MinHeight="10"
                   Height="30"
                   Grid.Column="0"
                   Grid.Row="0"
                   Grid.ColumnSpan="3">

                <TextBlock Text="Find:"
                   DockPanel.Dock="Left"
                   Margin="3"
                   Height="18">
                </TextBlock>

                <TextBox MinHeight="15"
                     Height="18"
                     Margin="3">
                </TextBox>
            </DockPanel>

            <ListBox Grid.Row="1"
                 Grid.Column="0"
                 Grid.ColumnSpan="3"
                 Margin="0,3,0,3"
                 HorizontalContentAlignment="Stretch"
                 ItemsSource="{Binding Contacts}"
                 SelectedItem="{Binding SelectedContact}"
                 DisplayMemberPath="Name">
            </ListBox>


            <Button Content="Add"
                    Height="25"
                    Margin="3"
                    Grid.Column="0"
                    Grid.Row="2"
                    Command="{Binding AddCommand}"
             />

            <Button Content="Edit"
                    Height="25"
                    Margin="3"
                    Grid.Column="1"
                    Grid.Row="2"
                    Command="{Binding EditCommand}"
                    />

            <Button Content="Remove"
                    Height="25"
                    Margin="3"
                    Grid.Column="2"
                    Grid.Row="2"
                    Command="{Binding RemoveCommand}"
             />
        </Grid>

        <Grid Grid.Column="2"
              Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Image Source="Resources\photo_placeholder_100x100.png"
               Width="100"
               Height="100"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Margin="0,35,3,0"/>

            <StackPanel Grid.Column="1"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    VerticalAlignment="Top"
                    Height="auto"
                    Margin="3,13,0,0">

                <TextBlock TextWrapping="Wrap" 
                    Height="18"
                    VerticalAlignment="Center"
                    Text="Name:"
                    Margin="0,0,0,3"/>

                <TextBox MinWidth="225"
                     Height="18"
                     Margin="0,0,0,3"
                         TextWrapping="Wrap"
                     Text="{Binding SelectedContact.Name,
                UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsReadOnly}">
                </TextBox>

                <TextBlock TextWrapping="Wrap" 
                    Height="18"
                    VerticalAlignment="Center"
                    Text="PhoneNumber:"
                    Margin="0,0,0,3"/>

                <TextBox MinWidth="225"
                     Height="18"
                     Margin="0,0,0,3"
                         TextWrapping="Wrap"
                     Text="{Binding SelectedContact.PhoneNumber,
                UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsReadOnly}">
                </TextBox>

                <TextBlock Text="Email:"
                   VerticalAlignment="Center"
                   Margin="0,0,0,3"
                   TextWrapping="Wrap">
                </TextBlock>

                <TextBox MinWidth="225"
                     Height="18"
                     Margin="0,0,0,3"
                     TextWrapping="Wrap"
                     Text="{Binding SelectedContact.Email,
                UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsReadOnly}">
                </TextBox>

                <Button Content="Apply"
                Grid.Column="1"
                Grid.Row="1"
                Width="75"
                Height="25"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="0,50,0,0"
                Command="{Binding ApplyCommand}" 
                Visibility="{Binding IsVisibility, 
                Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>

        </Grid>
    </Grid>
</Window>
