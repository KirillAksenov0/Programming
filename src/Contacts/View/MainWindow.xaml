<Window x:Class="Contacts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Contacts"
        mc:Ignorable="d"
        Title="Contacts" 
        Height="500" 
        MinHeight="500" 
        Width="665"
        MinWidth="710"
        Icon="/books16.ico">
    <Window.Resources>

    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="0.6*"/>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Canvas Grid.Row="0" Grid.Column="0" Background="#f8f8f8"/>

        <Canvas Grid.Row="1" Grid.Column="0" Background="#f8f8f8"/>

        <Canvas Grid.Row="2" Grid.Column="0" Background="#f8f8f8"/>

        <GridSplitter Grid.Column="1" 
             ShowsPreview="False"
             Width="3"
             HorizontalAlignment="Center"
             VerticalAlignment="Stretch"
             Grid.RowSpan="3"/>


        <StackPanel Orientation="Horizontal"
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="3">

            <Label Content="Find:"
                   Margin="3">
            </Label>

            <TextBox MinWidth="280"
                     MinHeight="15"
                     Margin="3">
            </TextBox>

        </StackPanel>


        <ListBox Grid.Row="1"
                 Grid.Column="0"
                 Margin="3"
                 HorizontalContentAlignment="Stretch"/>

        <StackPanel Orientation="Horizontal"
                    Grid.Column="0"
                    Grid.Row="2"
                    Margin="3"
                    HorizontalAlignment="Center">

            <Button Content="Add"
                    Width="100"
                    Height="25"
                    Margin="3"/>

            <Button Content="Edit"
                    Width="100"
                    Height="25"
                    Margin="3"/>

            <Button Content="Remove"
                    Width="100"
                    Height="25"
                    Margin="3"/>

        </StackPanel>

        <Image Source="
                C:\Users\HONOR01\Programming\src\Contacts\View\Resources\photo_placeholder_100x100.png"
               Width="100"
               Height="100"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Margin="3"
               Grid.Column="2"
               Grid.Row="1">
        </Image>

        <StackPanel Grid.Column="2"
                    Grid.RowSpan="2"
                    Grid.Row="1"
                    Margin="108,3,3,3">
            
            <Label Content="Name:"
                   HorizontalAlignment="Left"
                   Margin="3">
            </Label>

            <TextBox MinWidth="225"
                     MinHeight="15"
                     Margin="3">
            </TextBox>

            <Label Content="PhoneNumber:"
                   HorizontalAlignment="Left"
                   Margin="3">
            </Label>

        </StackPanel>
    </Grid>
</Window>
