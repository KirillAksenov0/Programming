<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        xmlns:viewModel="clr-namespace:View.ViewModel"
        mc:Ignorable="d"
        Title="Contacts" 
        Height="500" 
        MinHeight="500" 
        Width="665"
        MinWidth="710"
        Icon="/books16.ico">
    <Window.Resources>
        <viewModel:BoolToVisibilityConverter 
            x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="0.6*"/>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Canvas Grid.Row="0" Grid.Column="0" Background="#f8f8f8"/>

        <Canvas Grid.Row="1" Grid.Column="0" Background="#f8f8f8"/>

        <Canvas Grid.Row="2" Grid.Column="0" Background="#f8f8f8"/>

        <GridSplitter Grid.Column="1" 
             ShowsPreview="False"
             Width="3"
             HorizontalAlignment="Center"
             VerticalAlignment="Stretch"
             Grid.RowSpan="3"/>

        <DockPanel LastChildFill="True"
                   MinHeight="10"
                   Height="30"
                   Margin="3">
            
            <Label Content="Find:"
                   DockPanel.Dock="Left"
                   Margin="3">
            </Label>

            <TextBox MinHeight="15"
                     Height="20"
                     >
            </TextBox>
        </DockPanel>
        
        <ListBox Grid.Row="1"
                 Grid.Column="0"
                 Margin="3"
                 HorizontalContentAlignment="Stretch"
                 ItemsSource="{Binding Contacts}"
                 SelectedItem="{Binding SelectedContact}"
                 DisplayMemberPath="Name">
        </ListBox>

        <StackPanel Orientation="Horizontal"
                    Grid.Column="0"
                    Grid.Row="2"
                    Margin="3"
                    HorizontalAlignment="Center">

            <Button Content="Add"
                    Width="100"
                    Height="25"
                    Margin="3"
                    Command="{Binding AddCommand}"/>

            <Button Content="Edit"
                    Width="100"
                    Height="25"
                    Margin="3"
                    Command="{Binding EditCommand}"
                    />

            <Button Content="Remove"
                    Width="100"
                    Height="25"
                    Margin="3"
                    Command="{Binding RemoveCommand}"
                    />

        </StackPanel>

        <Image Source="
                C:\Users\HONOR01\Programming\src\Contacts\View\Resources\photo_placeholder_100x100.png"
               Width="100"
               Height="100"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Margin="3,39,3,3"
               Grid.Column="2"
               Grid.Row="1">
        </Image>

        <StackPanel Grid.Column="2"
                    Grid.Row="1"
                    Margin="108,3,3,3">

            <Label Content="Name:"
                   HorizontalAlignment="Left"
                   Margin="3">
            </Label>

            <TextBox MinWidth="225"
                     MinHeight="15"
                     Margin="3"
                     Text="{Binding EditableContact.Name, 
                UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsReadOnly}">
            </TextBox>

            <Label Content="PhoneNumber:"
                   HorizontalAlignment="Left"
                   Margin="3">
            </Label>

            <TextBox MinWidth="225"
                     MinHeight="15"
                     Margin="3"
                     Text="{Binding EditableContact.PhoneNumber,
                UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsReadOnly}">
            </TextBox>

            <Label Content="Email:"
                   HorizontalAlignment="Left"
                   Margin="3">
            </Label>

            <TextBox MinWidth="225"
                     MinHeight="15"
                     Margin="3"
                     Text="{Binding EditableContact.Email,
                UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsReadOnly}">
            </TextBox>

        </StackPanel>

        <StackPanel Grid.Row="1"
                    Grid.Column="2"
                    Margin="108,167,0,118">

            <Button Content="Apply"
                MinWidth="75"
                Width="75"
                MinHeight="25"
                HorizontalAlignment="Left"
                Margin="3,50,50,50"
                Command="{Binding ApplyCommand}" 
                Visibility="{Binding IsVisibility, 
                Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>
    </Grid>
</Window>
