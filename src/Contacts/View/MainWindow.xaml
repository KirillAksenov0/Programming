<Window x:Class="Contacts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Contacts"
        mc:Ignorable="d"
        Title="Contacts" 
        Height="500" 
        MinHeight="500" 
        Width="665"
        MinWidth="710"
        Icon="/books16.ico">
    <Window.Resources>

    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="0.7*"/>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Canvas Grid.Row="0" Grid.Column="0" Background="#f8f8f8"/>

        <Canvas Grid.Row="1" Grid.Column="0" Background="#f8f8f8"/>

        <Canvas Grid.Row="2" Grid.Column="0" Background="#f8f8f8"/>

        <GridSplitter Grid.Column="1" 
             ShowsPreview="False"
             Width="3"
             HorizontalAlignment="Center"
             VerticalAlignment="Stretch"
             Grid.RowSpan="3"/>

        <GroupBox Grid.Column="0"
                  Grid.Row="0"
                  Margin="3"
                  HorizontalContentAlignment="Stretch"
                  Background="#f8f8f8"
                  VerticalAlignment="Center">

            <StackPanel Orientation="Horizontal">

                <Label Content="Find:"
                 Margin="3"
                       HorizontalAlignment="Left"/>

                <TextBox MinWidth="280"
                         Margin="3"
                         
                 />
            </StackPanel>
        </GroupBox>

        <ListBox Grid.Row="1"
                 Grid.Column="0"
                 Margin="3"
                 HorizontalContentAlignment="Stretch"/>

        <Button Grid.Column="0"
                Grid.Row="2"
                Content="Add"
                Width="85"
                Height="25"
                MinHeight="25"
                Margin="3"
                HorizontalAlignment="Left"/>
    </Grid>
</Window>
