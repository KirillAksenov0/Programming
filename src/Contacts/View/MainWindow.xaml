<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        xmlns:Converters="clr-namespace:View.Converters"
        xmlns:userControl="clr-namespace:View.Controls"
        mc:Ignorable="d"
        Title="Contacts" 
        Height="500" 
        MinHeight="500" 

        Width="750"
        MinWidth="750"

        Icon="/Resources/books16.ico">

    <Window.Resources>
        <Converters:BoolToVisibilityConverter
            x:Key="BoolToVisibilityConverter"/>

        <DataTemplate x:Key="contactTemplate">
            <DockPanel>
                <Image Source="Resources\photo_placeholder_100x100.png"
                       Width="40"
                       Height="40">
                    <Image.Clip>
                        <EllipseGeometry Center="20, 20"
                                         RadiusX="20"
                                         RadiusY="20"/>
                    </Image.Clip>
                </Image>
                <StackPanel Margin="3">
                    <TextBlock FontWeight="Bold" 
                               Text="{Binding Name}"/>
                    <TextBlock Text="{Binding PhoneNumber}"/>
                </StackPanel>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <Canvas Grid.Row="0" Grid.Column="0" Background="#f8f8f8"/>

        <Canvas Grid.Row="1" Grid.Column="0" Background="#f8f8f8"/>

        <Canvas Grid.Row="2" Grid.Column="0" Background="#f8f8f8"/>

        <GridSplitter Grid.Column="1" 
             ShowsPreview="False"
             Width="3"
             HorizontalAlignment="Center"
             VerticalAlignment="Stretch"
             Grid.RowSpan="3"/>

        <Grid Grid.Column="0"
              Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <DockPanel LastChildFill="True"
                   MinHeight="10"
                   Height="30"
                   Grid.Column="0"
                   Grid.Row="0"
                   Grid.ColumnSpan="3">

                <TextBlock Text="Find:"
                   DockPanel.Dock="Left"
                   Margin="3"
                   Height="18">
                </TextBlock>

                <TextBox MinHeight="15"
                     Height="18"
                     Margin="3">
                </TextBox>
            </DockPanel>

            <ListBox Grid.Row="1"
                 Grid.Column="0"
                 Grid.ColumnSpan="3"
                 Margin="0,3,0,3"
                 HorizontalContentAlignment="Stretch"
                 ItemsSource="{Binding Contacts}"
                 SelectedItem="{Binding SelectedContact}"
                 ItemTemplate="{StaticResource contactTemplate}">
            </ListBox>


            <Button Content="Add"
                    Height="25"
                    Margin="3"
                    Grid.Column="0"
                    Grid.Row="2"
                    Command="{Binding AddCommand}"
             />

            <Button Content="Edit"
                    Height="25"
                    Margin="3"
                    Grid.Column="1"
                    Grid.Row="2"
                    Command="{Binding EditCommand}"
                    />

            <Button Content="Remove"
                    Height="25"
                    Margin="3"
                    Grid.Column="2"
                    Grid.Row="2"
                    Command="{Binding RemoveCommand}"
             />
        </Grid>

        <Grid Grid.Column="2"
              Margin="8">
            
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <userControl:ContactControl x:Name="ContactControl"
                                        Grid.Row="0"
                                        SelectedContact ="{Binding SelectedContact}"/>
        </Grid>
    </Grid>
</Window>
