<Window x:Class="Contacts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Contacts"
        mc:Ignorable="d"
        Title="Contacts" 
        Height="500" 
        MinHeight="500" 
        Width="665"
        MinWidth="710"
        Icon="/books16.ico">
    <Window.Resources>

    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="46*"></RowDefinition>
            <RowDefinition Height="7*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <GroupBox 
            Grid.Row="0" 
            Grid.Column="0" 
            Header="Edit Contact" 
            Margin="3,3,3,3"
            HorizontalContentAlignment="Stretch"
            >

            <StackPanel>
                <Label
                    Content="Name:" 
                    MinHeight="25" 
                    HorizontalAlignment="Left" 
                    Margin="3 3 3 3">
                </Label>

                <TextBox  
                    Text="{Binding Path=Name,
                    UpdateSourceTrigger=PropertyChanged,
                    Mode=TwoWay}" 
                    MinWidth="275"
                    Margin="3 3 3 3" 
                    MinHeight="20">

                </TextBox>
                <Label 
                    Content="Phone Number:" 
                    MinHeight="25" 
                    HorizontalAlignment="Left" 
                    Margin="3 3 3 3">
                </Label>

                <TextBox 
                    Text="{Binding Path=PhoneNumber, 
                    UpdateSourceTrigger=PropertyChanged,
                    Mode=TwoWay}" 
                    MinWidth="275"
                    MinHeight="20" 
                    Margin="3 3 3 3">
                </TextBox>

                <Label 
                    Content="Email:" 
                    MinHeight="25" 
                    HorizontalAlignment="Left" 
                    Margin="3 3 3 3">
                </Label>

                <TextBox  
                    Text="{Binding Path=Email, 
                    UpdateSourceTrigger=PropertyChanged,
                    Mode=TwoWay}" 
                    MinWidth="275"
                    MinHeight="20" 
                    Margin="3 3 3 3">
                </TextBox>
            </StackPanel>
        </GroupBox>
        <GroupBox 
            Grid.Row="0" 
            Grid.Column="1" 
            Header="Read Contact"
            MinWidth="300" 
            MinHeight="350"
            Margin="3,3,3,3"
            >

            <StackPanel>
                <Label
                    Content="Name:" 
                    MinHeight="25" 
                    HorizontalAlignment="Left" 
                    Margin="3 3 3 3">
                </Label>

                <TextBox 
                    Text="{Binding Path=Name, 
                    Mode=OneWay, 
                    UpdateSourceTrigger=PropertyChanged}" 
                    HorizontalAlignment="Left" 
                    Margin="3 3 3 3" 
                    MinWidth="275" 
                    MinHeight="20"
                    BorderThickness="0" 
                    FontWeight="Bold">
                </TextBox>

                <Label 
                    Content="Phone Number:"
                    MinHeight="25" 
                    HorizontalAlignment="Left" 
                    Margin="3 3 3 3">
                </Label>

                <TextBox
                    Text="{Binding Path=PhoneNumber, 
                    Mode=OneWay, 
                    UpdateSourceTrigger=PropertyChanged}"
                    MinHeight="20" 
                    MinWidth="275" 
                    HorizontalAlignment="Left" 
                    Margin="3 3 3 3" 
                    FontWeight="Bold"
                    BorderThickness="0">
                </TextBox>

                <Label
                    MinHeight="25"
                    Content="Email:" 
                    HorizontalAlignment="Left"
                    Margin="3 3 3 3">
                </Label>

                <TextBox 
                    Text=
                    "{Binding Path=Email,
                    Mode=OneWay,
                    UpdateSourceTrigger=PropertyChanged}"
                    MinHeight="20" 
                    MinWidth="275" 
                    HorizontalAlignment="Left" 
                    Margin="3 3 3 3" 
                    FontWeight="Bold"
                    BorderThickness="0">
                </TextBox>
            </StackPanel>

        </GroupBox>

        <Button 
            Grid.Row="1" 
            Grid.Column="1" 
            Width="75" 
            Height="25"
            Content="Load" 
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="242,0,0,0"
            Command="{Binding LoadCommand}">
        </Button>
        <Button 
            Grid.Row="1" 
            Grid.Column="1" 
            Width="75" 
            Height="25"
            MinHeight="25" 
            MinWidth="75" 
            Content="Save" 
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="3,3,100,0"
            Command="{Binding SaveCommand}"
            >
        </Button>

    </Grid>
</Window>
